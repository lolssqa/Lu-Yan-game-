local RainbowTheme = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromHex("FF0000")),
	ColorSequenceKeypoint.new(0.17, Color3.fromHex("FF9900")),
	ColorSequenceKeypoint.new(0.33, Color3.fromHex("FFFF00")),
