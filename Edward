local EdwardTrainTab = Tabs.EdwardTrainTab
local shootThread
local drawTracers = false
local tracerTable = {}
_G.TracerSingleColor = Color3.new(1, 0.7, 0.15)
_G.TracerRainbowMode = false

local function ClearAllTracer()
    for _, drawObj in tracerTable do
        if drawObj.Remove then drawObj:Remove() end
    end
    table.clear(tracerTable)
end

local function MakeTrace(startPos, endPos)
    local cam = workspace.CurrentCamera
    local p1, on1 = cam:WorldToViewportPoint(startPos)
    local p2, on2 = cam:WorldToViewportPoint(endPos)
    if not on1 and not on2 then return end

    local line = Drawing.new("Line")
    local hue = tick() % 3
    line.From = Vector2.new(p1.X, p1.Y)
    line.To = Vector2.new(p2.X, p2.Y)
    line.Thickness = 2.2
    line.Visible = true
    if _G.TracerRainbowMode then
        line.Color = Color3.fromHSV(hue, 1, 1)
    else
        line.Color = _G.TracerSingleColor
    end
    table.insert(tracerTable, line)
    task.delay(0.07, function()
        pcall(function() line:Remove() end)
    end)
end

EdwardTrainTab:Toggle({
    Title = "SP1911自动扫射",
    Icon = "check",
    Default = false,
    Callback = function(enabled)
        local runThread
        if enabled then
            runThread = task.spawn(function()
                local equipRF = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("WeaponService"):WaitForChild("RF"):WaitForChild("EquipWeapon")
                equipRF:InvokeServer("Weapon_SP1911")
                local localEdwardFolder = workspace:WaitForChild("LocalEdward")
                local localEdwardClient = localEdwardFolder:WaitForChild("LocalEdwardClient")
                local head = localEdwardClient:WaitForChild("Head")
                local headPart = head:FindFirstChildWhichIsA("BasePart") or head:FindFirstChildWhichIsA("MeshPart")
                if not headPart then return end
                local shootRE = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("WeaponService"):WaitForChild("RE"):WaitForChild("ShootProjectile")
                while enabled do
                    pcall(function()
                        local args = {
                            headPart.Position,
                            headPart.CFrame.LookVector,
                            0
                        }
                        shootRE:FireServer(unpack(args))
                        -- 开枪时生成弹道
                        if drawTracers then
                            local endPoint = headPart.Position + headPart.CFrame.LookVector * 800
                            MakeTrace(headPart.Position, endPoint)
                        end
                    end)
                    task.wait()
                end
            end)
            getgenv().edwardGunLoop = runThread
            WindUI:Notify({Title="武器",Content="SP1911扫射已开启",Duration=2})
        else
            if getgenv().edwardGunLoop then
                task.cancel(getgenv().edwardGunLoop)
                getgenv().edwardGunLoop = nil
            end
            ClearAllTracer()
            WindUI:Notify({Title="武器",Content="SP1911扫射已关闭",Duration=2})
        end
    end
})

