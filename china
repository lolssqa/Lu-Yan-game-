MainTab:Section({Title = "低人数服务器"})

MainTab:Button({
    Title = "查询最少人服务器",Icon="search",
    Callback = function()
        local suc,res = pcall(function()
            local raw=game:HttpGet(string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",targetPlaceId))
            local d=HttpService:JSONDecode(raw).data
            local minPlr,job=math.huge,nil
            for _,s in ipairs(d) do
                if s.playing<minPlr then minPlr=s.playing; job=s.id end
            end
            return {plr=minPlr,jid=job}
        end)
        if suc and res then
            bestJobId=res.jid; bestPlayerCount=res.plr
            WindUI:Notify({Title="查询完成",Content="最少人："..bestPlayerCount.."人",Duration=2})
        else
            WindUI:Notify({Title="错误",Content="限流/网络",Duration=3})
        end
    end
})

MainTab:Button({
    Title = "跳转找到的服务器",Icon="log-in",Color=Color3.fromHex("#288bd8"),
    Callback = function()
        if not bestJobId then WindUI:Notify({Title="提示",Content="先查询服务器",Duration=2}) return end
        pcall(function() TeleportService:TeleportToPlaceInstance(targetPlaceId,bestJobId,LocalPlayer) end)
    end
})

