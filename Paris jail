MainTab:Section({Title = "炮弹功能"})
local ShootToggle = MainTab:Toggle({
    Title = "自动发射FoodZooka",
    Value = false,
    Callback = function(state)
        shootActive = state
        if state then
            WindUI:Notify({Title="炮弹",Content="FoodZooka自动发射开启",Duration=2})
            shootLoop = task.spawn(function()
                while shootActive do
                    local char = LocalPlayer.Character
                    if not char then task.wait() continue end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then task.wait() continue end

                    local targetDir
                    if shootAllPlayer then
                        local nearestPlayer
                        local minDist = math.huge
                        for _,plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                                local enemyRoot = plr.Character.HumanoidRootPart
                                local dist = (root.Position - enemyRoot.Position).Magnitude
                                if dist < minDist then
                                    minDist = dist
                                    nearestPlayer = enemyRoot
                                end
                            end
                        end
                        if nearestPlayer then
                            targetDir = (nearestPlayer.Position - root.Position).Unit
                        else
                            targetDir = root.CFrame.LookVector
                        end
                    else
                        targetDir = root.CFrame.LookVector
                    end

                    local args = {
	                    {
		                    "FoodZooka",
		                    workspace:WaitForChild("godwhy532FoodZooka"),
		                    game:GetService("ReplicatedStorage"):WaitForChild("ShopAssetsFolder"):WaitForChild("ToolsFolder"):WaitForChild("VipBullets"):WaitForChild("FoodZookaBullets"),
		                    {
			                    ReloadTime = 0.4,
			                    Force = 20,
			                    BulletSpeed = 100,
			                    Damage = 10
		                    },
		                    targetDir,
		                    {
			                    ReloadTime = 0.4,
			                    Force = 20,
			                    BulletSpeed = 100,
			                    Damage = 10
		                    },
		                    false
	                    }
                    }
                    game:GetService("ReplicatedStorage"):WaitForChild("ShopAssetsFolder"):WaitForChild("AssetRemotes"):WaitForChild("VipRemotes"):WaitForChild("SendProjectile"):FireServer(unpack(args))
                    task.wait(0.4)
                end
            end)
        else
            if shootLoop then
                task.cancel(shootLoop)
                shootLoop = nil
            end
            WindUI:Notify({Title="炮弹",Content="FoodZooka自动发射关闭",Duration=2})
        end
    end
})

