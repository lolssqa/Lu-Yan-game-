        Fluent:Notify({Title="点位切换",Content="已选中："..selectedName,Duration=1.5})
    end
})

Tabs.Main:AddInput("SpeedInput",{
    Title = "移动速度",
    Placeholder = "默认16",
    Default = "16",
    Callback = function(inputText)
        local num = tonumber(inputText)
        if num then
            moveSpeed = math.clamp(num,1,200)
            Fluent:Notify({Title="速度设置",Content="当前速度："..tostring(moveSpeed),Duration=1.2})
        else
            Fluent:Notify({Title="速度设置",Content="请输入有效数字",Duration=1.2})
        end
    end
})

Tabs.Main:AddToggle("AutoRunToggle",{
    Title = "开启自动跑向点位",
