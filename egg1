local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local moveSpeed = 16
local targetPos = Vector3.new(598.6,70.6,-335.2)
local escapePos = Vector3.new(539.0,70.6,-363.9)
local started = false
local escapeLocked = false
local firePromptConn = nil

local targetColor = Color3.fromRGB(163, 0, 3)
local colorTolerance = 0.05

local function colorMatch(c1, c2, tol)
	return math.abs(c1.R - c2.R) < tol and math.abs(c1.G - c2.G) < tol and math.abs(c1.B - c2.B) < tol
end

local function checkRunColor()
	local runUI = PlayerGui:FindFirstChild("Run", true)
	if runUI and runUI:IsA("GuiObject") and runUI.Visible then
		if colorMatch(runUI.BackgroundColor3, targetColor, colorTolerance) then
			return true
		end
	end
	return false
end

ProximityPromptService.PromptTriggered:Connect(function(prompt,plr)
	if plr ~= LocalPlayer then return end
	escapeLocked = true
end)

RunService.Heartbeat:Connect(function(dt)
	local hasRun = checkRunColor()
	if hasRun then
		escapeLocked = true
	end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if escapeLocked then
		local currentPos = hrp.Position
		local direction = (escapePos - currentPos).Unit
		local distance = (escapePos - currentPos).Magnitude
		if distance > 1 then
			local newPos = currentPos + Vector3.new(direction.X,0,direction.Z) * moveSpeed * dt
			hrp.CFrame = CFrame.new(newPos, Vector3.new(escapePos.X, hrp.Position.Y, escapePos.Z))
		end
		return
	end

	if not started then return end

	local currentPos = hrp.Position
	local direction = (targetPos - currentPos).Unit
	local distance = (targetPos - currentPos).Magnitude
	if distance > 1 then
		local newPos = currentPos + Vector3.new(direction.X,0,direction.Z) * moveSpeed * dt
		hrp.CFrame = CFrame.new(newPos, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
	else
		local prompt = workspace:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt:Triggered(LocalPlayer)
		end
	end
end)

