PurchaseTab:Section({Title = "批量购买发包(1~25)"})
PurchaseTab:Input({
    Title = "发包间隔(秒)",
    Default = "0.4",
    Callback = function(text)
        local num = tonumber(text)
        if num then buyDelay = math.clamp(num,0.0000001,10) end
    end
})
PurchaseTab:Toggle({
    Title = "循环发包",
    Value = false,
    Callback = function(state)
        sendActive = state
        task.spawn(function()
            local idx = 1
            while sendActive do
                if not remoteEvent then GetRemote() end
                if remoteEvent then
                    local pack = packageList[idx]
                    remoteEvent:FireServer(unpack({{pack,"\002"}}))
                end
                idx +=1
                if idx>25 then idx=1 end
                task.wait(buyDelay)
            end
        end)
    end
})
PurchaseTab:Button({
    Title = "一次性跑完25条",
    Callback = function()
