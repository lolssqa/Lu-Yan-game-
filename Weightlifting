local PurchaseTab = Window:Tab({Title = "举起一个立方体",Icon = "package"})
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remoteEvent
local function GetRemote()
    local bridgeNet = ReplicatedStorage:FindFirstChild("ffrostflame_bridgenet2@1.0.0")
    if not bridgeNet then
        WindUI:Notify({Title="错误",Content="找不到BridgeNet!",Duration=3})
        return nil
    end
    remoteEvent = bridgeNet:FindFirstChild("dataRemoteEvent")
    if not remoteEvent then
        WindUI:Notify({Title="错误",Content="找不到dataRemoteEvent!",Duration=3})
    end
    return remoteEvent
end
GetRemote()

