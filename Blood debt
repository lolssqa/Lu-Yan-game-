local ESP_Active = false
local ESP_Container = nil
local ConnList = {}

local RoleColorTable = {
    Murderer = Color3.new(1, 0.15, 0.15),
    Sheriff = Color3.new(0.1, 0.6, 1),
    Innocent = Color3.new(0.2, 1, 0.3),
    Unknown = Color3.new(0.7, 0.7, 0.7)
}
local RoleNameTable = {
    Murderer = "杀手",
    Sheriff = "警长",
    Innocent = "平民",
    Unknown = "未知身份"
}

local function GetTrueRole(targetPlayer)
    local roleData = targetPlayer:GetAttribute("Role")
    if roleData then
        return roleData, false
    end
    local char = targetPlayer.Character
    if not char then
        return "Unknown", true
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local tname = tool.Name:lower()
        if tname:find("gun") or tname:find("枪") then
            return "Sheriff", true
        else
            return "Murderer", true
        end
    end
    return "Innocent", true
end

local function FullClearESP()
    if ESP_Container then
        pcall(function() ESP_Container:Destroy() end)
    end
    ESP_Container = nil
    for _, link in ipairs(ConnList) do
        pcall(function() link:Disconnect() end)
    end
    table.clear(ConnList)
end

local function MakePlayerESP(playerObj, characterModel)
    if not ESP_Active or not ESP_Container then return end
    local Head = characterModel:FindFirstChild("Head")
    local Humanoid = characterModel:FindFirstChild("Humanoid")
    if not Head or not Humanoid then return end

    local Outline = Instance.new("Highlight")
    Outline.Name = "PlayerOutline"
    Outline.Adornee = characterModel
    Outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Outline.FillTransparency = 1
    Outline.OutlineTransparency = 0
    Outline.Parent = ESP_Container

    local Billboard = Instance.new("BillboardGui")
    Billboard.Adornee = Head
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 220, 0, 80)
    Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    Billboard.Parent = ESP_Container

    local InfoLabel = Instance.new("TextLabel")
    InfoLabel.Size = UDim2.new(1, 0, 1, 0)
    InfoLabel.BackgroundTransparency = 1
    InfoLabel.Font = Enum.Font.SourceSansBold
    InfoLabel.TextSize = 17
    InfoLabel.Parent = Billboard

    local function UpdateDisplay()
        local role, isGuess = GetTrueRole(playerObj)
        Outline.OutlineColor = RoleColorTable[role]
        InfoLabel.TextColor3 = RoleColorTable[role]
        local suffix = isGuess and " (推测)" or ""
        InfoLabel.Text = playerObj.Name.."\n"..RoleNameTable[role]..suffix
    end
    UpdateDisplay()

    local healthConnect
    healthConnect = Humanoid.HealthChanged:Connect(function(hp)
        UpdateDisplay()
        if hp <= 0 then
            Outline.Enabled = false
            Billboard.Enabled = false
        else
            Outline.Enabled = true
            Billboard.Enabled = true
        end
    end)
    table.insert(ConnList, healthConnect)

    local destroyConnect
    destroyConnect = characterModel.Destroying:Connect(function()
        pcall(function() Outline:Destroy() Billboard:Destroy() healthConnect:Disconnect() end)
    end)
    table.insert(ConnList, destroyConnect)
end

local function RefreshAllESP()
    if not ESP_Active then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if char then
            task.spawn(MakePlayerESP, plr, char)
        end
        local respawnCon
        respawnCon = plr.CharacterAdded:Connect(function(newChar)
            task.wait(0.4)
            if ESP_Active then
                MakePlayerESP(plr, newChar)
            end
        end)
        table.insert(ConnList, respawnCon)
    end
end

