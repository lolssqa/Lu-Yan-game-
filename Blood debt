		if hudAnimating or not hudVisible then return end
		hudVisible = false
		hudAnimating = true
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 0.35, 0)})
		tween:Play()
